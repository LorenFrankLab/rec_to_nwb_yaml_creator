# react-scripts@5 declares typescript as an optional peer pinned to ^3||^4, but this
# project intentionally uses typescript@5 (see the TypeScript bootstrap). Without this,
# any `npm install <pkg>` re-resolves the tree and fails ERESOLVE on that optional-peer
# mismatch. legacy-peer-deps keeps install AND `npm ci` tolerant and the lockfile in sync.
legacy-peer-deps=true
