{
  "compilerOptions": {
    // --- Options carried over from the former jsconfig.json ---
    "checkJs": false,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "target": "ES2020",
    "module": "esnext",
    "baseUrl": ".",
    // NOTE: the `@/*` -> `src/*` alias is currently resolved for BOTH the build and the
    // test lane by `resolve.alias` in vite.config.ts, not here. No build-included source
    // imports via "@/". (It used to be kept out because Create React App forbade
    // `compilerOptions.paths` and rewrote tsconfig.json; that constraint is gone now that
    // the build is Vite, so adding `paths` here is a possible future cleanup.)

    // --- TypeScript bootstrap ---
    "allowJs": true,
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],

    // --- Recommended for the Vite/esbuild single-file transform (isolatedModules is
    //     required by esbuild; the rest were carried over from the CRA setup) ---
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist"]
}
